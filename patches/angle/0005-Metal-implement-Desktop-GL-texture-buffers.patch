+            textureBufferDescriptorWithPixelFormat:format.metalFormat
+                                             width:width
+                                   resourceOptions:buffer->get().resourceOptions
+                                             usage:MTLTextureUsageShaderRead];
+
+        auto metalTexture = adoptObjCObj([buffer->get() newTextureWithDescriptor:desc
+                                                                         offset:offset
+                                                                    bytesPerRow:bytesPerRow]);
+        ANGLE_MTL_CHECK(context, metalTexture, GL_OUT_OF_MEMORY);
+        context->getMetalDevice().setOwnerWithIdentity(metalTexture);
+
+        refOut->reset(new Texture(buffer.get(), metalTexture));
+        refOut->get()->setColorWritableMask(GetEmulatedColorWriteMask(format));
+        return angle::Result::Continue;
+    }  // ANGLE_MTL_OBJC_SCOPE
+}

+class DesktopMetalTextureBufferTest : public ANGLETest<>
+{
+  protected:
+    DesktopMetalTextureBufferTest()
+    {
+        setWindowWidth(16);
+        setWindowHeight(16);
+        setConfigRedBits(8);
+        setConfigGreenBits(8);
+        setConfigBlueBits(8);
+        setConfigAlphaBits(8);
+    }
+};
+
+// Regression for a Desktop GL frontend/backend mismatch that left the zero texture uninitialized
+// and TextureMtl::setBuffer unimplemented. A one-byte R8I buffer also exercises Metal's required
+// row padding, and reallocating the buffer verifies that the native texture view is refreshed.
+TEST_P(DesktopMetalTextureBufferTest, R8ITextureBufferDrawAndReallocate)
+{
+    constexpr char kVS[] = R"(#version 330 core
+in vec4 position;
+void main()
+{
+    gl_Position = position;
+})";
+
+    constexpr char kFS[] = R"(#version 330 core
+uniform isamplerBuffer bufferTexture;
+out vec4 colorOut;
+void main()
+{
+    int value = texelFetch(bufferTexture, 0).r;
+    colorOut = value == 7 ? vec4(1.0, 0.0, 0.0, 1.0)
+                          : (value == 9 ? vec4(0.0, 1.0, 0.0, 1.0)
+                                        : vec4(0.0, 0.0, 1.0, 1.0));
+})";
+
+    ANGLE_GL_PROGRAM(program, kVS, kFS);
+
+    GLBuffer buffer;
+    glBindBuffer(GL_TEXTURE_BUFFER, buffer);
+    GLbyte value = 7;
+    glBufferData(GL_TEXTURE_BUFFER, sizeof(value), &value, GL_DYNAMIC_DRAW);
+
+    GLTexture texture;
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_BUFFER, texture);
+    glTexBuffer(GL_TEXTURE_BUFFER, GL_R8I, buffer);
+    ASSERT_GL_NO_ERROR();
+
+    drawQuad(program, "position", 0.5f);
+    ASSERT_GL_NO_ERROR();
+    EXPECT_PIXEL_COLOR_EQ(0, 0, GLColor::red);
+
+    value = 9;
+    glBufferData(GL_TEXTURE_BUFFER, sizeof(value), &value, GL_DYNAMIC_DRAW);
+    drawQuad(program, "position", 0.5f);
+    ASSERT_GL_NO_ERROR();
+    EXPECT_PIXEL_COLOR_EQ(0, 0, GLColor::green);
+}
+
 GTEST_ALLOW_UNINSTANTIATED_PARAMETERIZED_TEST(DesktopGLSLTest);
 ANGLE_INSTANTIATE_TEST_GL32_CORE(DesktopGLSLTest);
 
+GTEST_ALLOW_UNINSTANTIATED_PARAMETERIZED_TEST(DesktopMetalTextureBufferTest);
+ANGLE_INSTANTIATE_TEST(DesktopMetalTextureBufferTest, GL32_CORE_METAL());
+
 }  // namespace angle

+angle::Result TextureMtl::ensureBufferTextureCreated(const gl::Context *context)
+{
+    ASSERT(mState.getType() == gl::TextureType::Buffer);
+
+    ContextMtl *contextMtl                                    = mtl::GetImpl(context);
+    const gl::OffsetBindingPointer<gl::Buffer> &bufferBinding = mState.getBuffer();
+    gl::Buffer *buffer                                        = bufferBinding.get();
+    if (!buffer)
+    {
+        if (mNativeTextureStorage)
+        {
+            deallocateNativeStorage(/*keepImages=*/false);
+            contextMtl->invalidateCurrentTextures();
+        }
+        return angle::Result::Continue;
+    }
+
+    BufferMtl *bufferMtl       = mtl::GetImpl(buffer);
+    mtl::BufferRef metalBuffer = bufferMtl->getCurrentBuffer();
+
+    const GLintptr bindingOffset = bufferBinding.getOffset();
+    const GLsizeiptr bindingSize = gl::GetBoundBufferAvailableSize(bufferBinding);
+    ANGLE_MTL_CHECK(contextMtl, bindingOffset >= 0 && bindingSize >= 0, GL_INVALID_VALUE);
+
+    const gl::InternalFormat &internalFormatInfo =
+        gl::GetSizedInternalFormatInfo(mBufferInternalFormat);
+    const size_t intendedPixelBytes = internalFormatInfo.pixelBytes;
+    ANGLE_MTL_CHECK(contextMtl, intendedPixelBytes != 0, GL_INVALID_ENUM);
+
+    const size_t logicalWidth = static_cast<size_t>(bindingSize) / intendedPixelBytes;
+    const size_t clampedWidth = std::min(
+        logicalWidth, static_cast<size_t>(std::max(context->getCaps().maxTextureBufferSize, 0)));
+    const uint32_t width = static_cast<uint32_t>(clampedWidth);
+    if (width == 0)
+    {
+        if (mNativeTextureStorage)
+        {
+            deallocateNativeStorage(/*keepImages=*/false);
+            contextMtl->invalidateCurrentTextures();
+        }
+        return angle::Result::Continue;
+    }
+    const angle::FormatID angleFormatID = angle::Format::InternalFormatToID(mBufferInternalFormat);
+    const mtl::Format &format           = contextMtl->getPixelFormat(angleFormatID);
+    ANGLE_MTL_CHECK(contextMtl, format.valid(), GL_INVALID_OPERATION);
+
+    // A raw Metal texture view cannot represent formats whose texel layout ANGLE emulates
+    // (notably three-component formats). Do not silently change the GL element stride.
+    ANGLE_MTL_CHECK(contextMtl, format.intendedFormatId == format.actualFormatId,
+                    GL_INVALID_OPERATION);
+    const size_t actualPixelBytes = format.actualAngleFormat().pixelBytes;
+    ANGLE_MTL_CHECK(contextMtl, actualPixelBytes == intendedPixelBytes, GL_INVALID_OPERATION);
+
+    const NSUInteger alignment = [contextMtl->getMetalDevice().get()
+        minimumTextureBufferAlignmentForPixelFormat:format.metalFormat];
+    ANGLE_MTL_CHECK(contextMtl, alignment != 0, GL_INVALID_OPERATION);
+
+    const size_t unalignedBytesPerRow = static_cast<size_t>(width) * actualPixelBytes;
+    ANGLE_MTL_CHECK(contextMtl,
+                    unalignedBytesPerRow <=
+                        std::numeric_limits<size_t>::max() - (static_cast<size_t>(alignment) - 1),
+                    GL_OUT_OF_MEMORY);
+    const size_t bytesPerRow = roundUp(unalignedBytesPerRow, static_cast<size_t>(alignment));
+    ANGLE_MTL_CHECK(contextMtl,
+                    static_cast<size_t>(bindingOffset) <=
+                        std::numeric_limits<size_t>::max() - static_cast<size_t>(bytesPerRow),
+                    GL_OUT_OF_MEMORY);
+    const size_t requiredBufferSize = static_cast<size_t>(bindingOffset) + bytesPerRow;
+
+    ANGLE_TRY(bufferMtl->ensureTextureBufferCompatible(contextMtl, requiredBufferSize));
+    metalBuffer = bufferMtl->getCurrentBuffer();
+
+    const bool cachedViewMatches = mNativeTextureStorage && metalBuffer == mBufferTextureBacking &&
+                                   mBufferTextureOffset == static_cast<size_t>(bindingOffset) &&
+                                   mBufferTextureBytesPerRow == bytesPerRow &&
+                                   mBufferTextureWidth == width && mFormat == format;
+
+#if TARGET_OS_SIMULATOR
+    // MTLSimBuffer rejects linear texture views over shared storage. The GL buffer itself cannot
+    // simply become private because BufferMtl exposes it to map/glBufferSubData. Mirror it into a
+    // private GPU buffer and preserve command ordering with a blit instead.
+    const bool requiresPrivateBacking = metalBuffer->storageMode() != MTLStorageModePrivate;
+#else
+    constexpr bool requiresPrivateBacking = false;
+#endif
+
+    if (cachedViewMatches)
+    {
+        if (requiresPrivateBacking && mBufferTextureContentsDirty)
+        {
+            ANGLE_MTL_CHECK(contextMtl,
+                            mBufferTexturePrivateBacking &&
+                                mBufferTexturePrivateBacking->size() >= requiredBufferSize,
+                            GL_OUT_OF_MEMORY);
+            mtl::BlitCommandEncoder *blitEncoder = contextMtl->getBlitCommandEncoder();
+            blitEncoder->copyBuffer(metalBuffer, 0, mBufferTexturePrivateBacking, 0,
+                                    requiredBufferSize);
+        }
+        mBufferTextureContentsDirty = false;
+        return angle::Result::Continue;
+    }
+
+    deallocateNativeStorage(/*keepImages=*/false);
+    mFormat                   = format;
+    mBufferTextureBacking     = metalBuffer;
+    mBufferTextureOffset      = static_cast<size_t>(bindingOffset);
+    mBufferTextureBytesPerRow = bytesPerRow;
+    mBufferTextureWidth       = width;
+
+    mtl::BufferRef textureViewBuffer = metalBuffer;
+    if (requiresPrivateBacking)
+    {
+        ANGLE_TRY(mtl::Buffer::MakeBufferWithStorageMode(contextMtl, MTLStorageModePrivate,
+                                                         requiredBufferSize, nullptr,
+                                                         &mBufferTexturePrivateBacking));
+        mtl::BlitCommandEncoder *blitEncoder = contextMtl->getBlitCommandEncoder();
+        blitEncoder->copyBuffer(metalBuffer, 0, mBufferTexturePrivateBacking, 0,
+                                requiredBufferSize);
+        textureViewBuffer = mBufferTexturePrivateBacking;
+    }
+
+    mtl::TextureRef nativeTexture;
+    ANGLE_TRY(mtl::Texture::MakeBufferTexture(contextMtl, textureViewBuffer, mFormat, width,
+                                              static_cast<size_t>(bindingOffset), bytesPerRow,
+                                              &nativeTexture));
+
+    mNativeTextureStorage =
+        std::make_unique<NativeTextureWrapperWithViewSupport>(nativeTexture, /*baseGLLevel=*/0);
+    mViewFromBaseToMaxLevel =
+        std::make_unique<NativeTextureWrapper>(std::move(nativeTexture), /*baseGLLevel=*/0);
+    ANGLE_TRY(ensureSamplerStateCreated(context));
+    contextMtl->invalidateCurrentTextures();
+    mBufferTextureContentsDirty = false;
+
+    return angle::Result::Continue;
+}

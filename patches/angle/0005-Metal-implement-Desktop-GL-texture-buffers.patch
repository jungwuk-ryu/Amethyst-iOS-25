+angle::Result BufferMtl::ensureTextureBufferCompatible(ContextMtl *contextMtl,
+                                                       size_t requiredSize)
+{
+    mTextureBufferMinAllocationSize =
+        std::max(mTextureBufferMinAllocationSize, requiredSize);
+
+    if (mBuffer && mBuffer->size() >= requiredSize)
+    {
+        return angle::Result::Continue;
+    }
+
+    mtl::BufferRef oldBuffer = mBuffer;
+    const MTLStorageMode storageMode =
+        oldBuffer ? oldBuffer->storageMode()
+                  : mtl::Buffer::getStorageModeForUsage(contextMtl, mUsage);
+
+    ANGLE_TRY(allocateNewMetalBuffer(contextMtl, storageMode, std::max<size_t>(1, requiredSize),
+                                     /*returnOldBufferImmediately=*/false));
+
+    const size_t copySize =
+        oldBuffer ? std::min(static_cast<size_t>(mGLSize), oldBuffer->size()) : 0;
+    if (copySize != 0)
+    {
+        if (isOffsetAndSizeMetalBlitCompatible(0, copySize))
+        {
+            mtl::BlitCommandEncoder *blitEncoder = contextMtl->getBlitCommandEncoder();
+            blitEncoder->copyBuffer(oldBuffer, 0, mBuffer, 0, copySize);
+        }
+        else
+        {
+            const uint8_t *source = oldBuffer->mapReadOnly(contextMtl);
+            uint8_t *destination  = mBuffer->mapWithOpt(contextMtl, false, true);
+            std::copy(source, source + copySize, destination);
+            oldBuffer->unmapNoFlush(contextMtl);
+            mBuffer->unmapAndFlushSubset(contextMtl, 0, copySize);
+        }
+    }
+
+    if (oldBuffer)
+    {
+        contextMtl->getBufferManager().returnBuffer(contextMtl, oldBuffer);
+    }
+
+    return angle::Result::Continue;
+}

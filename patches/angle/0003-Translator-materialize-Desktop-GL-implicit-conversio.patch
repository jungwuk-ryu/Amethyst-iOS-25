+// Desktop GLSL permits int and uint expressions to be implicitly converted to
+// float when the other operand is floating point.  The converted type must be
+// represented in the AST so strongly typed backends such as Metal do not emit
+// invalid operations such as int2 / float.
+TEST(MSLOutputDesktopGLTest, MaterializesImplicitIntegerToFloatConversion)
+{
+    constexpr char kShader[] = R"(#version 330
+        layout(location = 0) in ivec2 UV2;
+        out vec2 texCoord;
+
+        void main()
+        {
+            texCoord = clamp(UV2 / 256.0 + 0.03125,
+                             vec2(0.03125),
+                             vec2(0.96875));
+            gl_Position = vec4(0.0);
+        })";
+
+    ShBuiltInResources resources;
+    InitBuiltInResources(&resources);
+
+    ShCompileOptions compileOptions       = {};
+    compileOptions.rescopeGlobalVariables = true;
+    compileOptions.validateAST            = true;
+
+    std::string translatedCode;
+    std::string infoLog;
+    ASSERT_TRUE(compileTestShader(GL_VERTEX_SHADER, SH_GL_CORE_SPEC, SH_MSL_METAL_OUTPUT, kShader,
+                                  &resources, compileOptions, &translatedCode, &infoLog))
+        << infoLog;
+
+    EXPECT_TRUE(
+        std::regex_search(translatedCode, std::regex(R"(metal::float2\([^\n]*UV2[^\n]*\))")))
+        << translatedCode;
+}
+

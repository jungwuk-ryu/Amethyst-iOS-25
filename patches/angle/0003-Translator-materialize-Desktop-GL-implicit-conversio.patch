+TIntermTyped *CreateImplicitFloatConversion(TIntermTyped *operand,
+                                            const TSourceLoc &loc,
+                                            TDiagnostics *diagnostics)
+{
+    ASSERT(operand->getBasicType() == EbtInt || operand->getBasicType() == EbtUInt);
+
+    TType convertedType(operand->getType());
+    convertedType.setBasicType(EbtFloat);
+    convertedType.setInvariant(false);
+    convertedType.setPrecise(false);
+    convertedType.setInterpolant(false);
+    convertedType.setMemoryQualifier(TMemoryQualifier::Create());
+    convertedType.setLayoutQualifier(TLayoutQualifier::Create());
+    convertedType.setInterfaceBlock(nullptr);
+
+    TIntermAggregate *conversion = TIntermAggregate::CreateConstructor(convertedType, {operand});
+    conversion->setLine(loc);
+    return conversion->fold(diagnostics);
+}
+
+bool DoImplicitConversionRanksDominate(const std::vector<unsigned int> &candidateRanks,
+                                       const std::vector<unsigned int> &otherRanks)
+{
+    ASSERT(candidateRanks.size() == otherRanks.size());
+
+    bool hasBetterRank = false;
+    for (size_t index = 0; index < candidateRanks.size(); ++index)
+    {
+        if (candidateRanks[index] > otherRanks[index])
+        {
+            return false;
+        }
+        hasBetterRank = hasBetterRank || candidateRanks[index] < otherRanks[index];
+    }
+    return hasBetterRank;
+}
+
+constexpr unsigned int kExactMatchConversionRank = 0;
+constexpr unsigned int kImplicitConversionRank   = 1;

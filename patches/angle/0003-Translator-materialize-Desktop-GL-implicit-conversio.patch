+void TParseContext::materializeImplicitIntToFloatConversion(TIntermTyped **left,
+                                                            TIntermTyped **right,
+                                                            const TSourceLoc &loc)
+{
+    if ((*left)->isArray() || (*right)->isArray())
+    {
+        ASSERT((*left)->getType() == (*right)->getType());
+        return;
+    }
+
+    const ImplicitTypeConversion conversion =
+        GetConversion((*left)->getBasicType(), (*right)->getBasicType());
+
+    switch (conversion)
+    {
+        case ImplicitTypeConversion::Left:
+            markStaticReadIfSymbol(*left);
+            *left = CreateImplicitFloatConversion(*left, loc, mDiagnostics);
+            break;
+        case ImplicitTypeConversion::Right:
+            markStaticReadIfSymbol(*right);
+            *right = CreateImplicitFloatConversion(*right, loc, mDiagnostics);
+            break;
+        case ImplicitTypeConversion::Same:
+        case ImplicitTypeConversion::Invalid:
+            break;
+    }
+}
+
+TIntermTyped *TParseContext::materializeImplicitIntToFloatConversion(const TType &expectedType,
+                                                                     TIntermTyped *operand,
+                                                                     const TSourceLoc &loc)
+{
+    if (expectedType.isArray() || operand->isArray())
+    {
+        ASSERT(expectedType == operand->getType());
+        return operand;
+    }
+
+    const ImplicitTypeConversion conversion =
+        GetConversion(expectedType.getBasicType(), operand->getBasicType());
+    if (conversion != ImplicitTypeConversion::Right)
+    {
+        return operand;
+    }
+
+    ASSERT(IsDesktopGLSpec(mShaderSpec));
+    ASSERT(expectedType.getBasicType() == EbtFloat);
+    markStaticReadIfSymbol(operand);
+    return CreateImplicitFloatConversion(operand, loc, mDiagnostics);
+}
+
+bool TParseContext::materializeImplicitIntToFloatConversions(const TFunction &function,
+                                                             TIntermSequence *arguments,
+                                                             const TSourceLoc &loc)
+{
+    ASSERT(function.getParamCount() == arguments->size());
+
+    for (size_t index = 0; index < arguments->size(); ++index)
+    {
+        const TType &parameterType = function.getParam(index)->getType();
+        TIntermTyped *argument     = (*arguments)[index]->getAsTyped();
+        const ImplicitTypeConversion conversion =
+            GetConversion(parameterType.getBasicType(), argument->getBasicType());
+        if (conversion == ImplicitTypeConversion::Same)
+        {
+            continue;
+        }
+
+        const TQualifier qualifier = parameterType.getQualifier();
+        if (conversion != ImplicitTypeConversion::Right || qualifier == EvqParamOut ||
+            qualifier == EvqParamInOut || parameterType.isArray() || argument->isArray() ||
+            parameterType.getNominalSize() != argument->getNominalSize() ||
+            parameterType.getSecondarySize() != argument->getSecondarySize())
+        {
+            return false;
+        }
+
+        ASSERT(IsDesktopGLSpec(mShaderSpec));
+        (*arguments)[index] = materializeImplicitIntToFloatConversion(parameterType, argument, loc);
+    }
+    return true;
+}
+
+bool TParseContext::getImplicitConversionRanks(const TFunction &function,
+                                               const TIntermSequence &arguments,
+                                               std::vector<unsigned int> *conversionRanks) const
+{
+    ASSERT(function.getParamCount() == arguments.size());
+    ASSERT(conversionRanks != nullptr);
+    conversionRanks->clear();
+    conversionRanks->reserve(arguments.size());
+
+    for (size_t index = 0; index < arguments.size(); ++index)
+    {
+        const TType &parameterType = function.getParam(index)->getType();
+        const TType &argumentType  = arguments[index]->getAsTyped()->getType();
+        if (parameterType == argumentType)
+        {
+            conversionRanks->push_back(kExactMatchConversionRank);
+            continue;
+        }
+
+        const TQualifier qualifier = parameterType.getQualifier();
+        if (qualifier == EvqParamOut || qualifier == EvqParamInOut || parameterType.isArray() ||
+            argumentType.isArray() ||
+            GetConversion(parameterType.getBasicType(), argumentType.getBasicType()) !=
+                ImplicitTypeConversion::Right)
+        {
+            return false;
+        }
+
+        TType convertedArgumentType(argumentType);
+        convertedArgumentType.setBasicType(EbtFloat);
+        if (convertedArgumentType != parameterType)
+        {
+            return false;
+        }
+        conversionRanks->push_back(kImplicitConversionRank);
+    }
+    return true;
+}
+
+const TSymbol *TParseContext::findFunctionWithImplicitConversions(TFunctionLookup &fnCall,
+                                                                  bool builtIn,
+                                                                  bool *isAmbiguous) const
+{
+    ASSERT(isAmbiguous != nullptr);
+    *isAmbiguous = false;
+
+    struct Candidate
+    {
+        const TSymbol *symbol;
+        std::vector<unsigned int> conversionRanks;
+    };
+
+    std::vector<Candidate> candidates;
+    for (const ImmutableString &name : fnCall.getMangledNamesForImplicitConversions())
+    {
+        const TSymbol *symbol =
+            builtIn ? symbolTable.findBuiltIn(name, mShaderVersion) : symbolTable.findGlobal(name);
+        if (symbol == nullptr || !symbol->isFunction())
+        {
+            continue;
+        }
+
+        const TFunction *candidate = static_cast<const TFunction *>(symbol);
+        std::vector<unsigned int> conversionRanks;
+        if (!getImplicitConversionRanks(*candidate, fnCall.arguments(), &conversionRanks))
+        {
+            continue;
+        }
+
+        candidates.push_back({symbol, conversionRanks});
+    }
+
+    if (candidates.empty())
+    {
+        return nullptr;
+    }
+    if (candidates.size() == 1)
+    {
+        return candidates[0].symbol;
+    }
+
+    // Before GLSL 4.10, any call with more than one viable implicit-conversion overload is
+    // ambiguous.  GLSL 4.10 introduced per-argument conversion ranking.
+    if (mShaderVersion < 410)
+    {
+        *isAmbiguous = true;
+        return nullptr;
+    }
+
+    for (const Candidate &candidate : candidates)
+    {
+        bool dominatesEveryOtherCandidate = true;
+        for (const Candidate &other : candidates)
+        {
+            if (candidate.symbol != other.symbol &&
+                !DoImplicitConversionRanksDominate(candidate.conversionRanks,
+                                                   other.conversionRanks))
+            {
+                dominatesEveryOtherCandidate = false;
+                break;
+            }
+        }
+        if (dominatesEveryOtherCandidate)
+        {
+            return candidate.symbol;
+        }
+    }
+
+    *isAmbiguous = true;
+    return nullptr;
+}

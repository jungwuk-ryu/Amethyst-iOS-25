+TEST_P(DesktopMetalTextureBufferTest, TexBufferRangeRequiresDesktopGL43)
+{
+    GLBuffer buffer;
+    glBindBuffer(GL_TEXTURE_BUFFER, buffer);
+    std::vector<GLbyte> data(256, 7);
+    glBufferData(GL_TEXTURE_BUFFER, data.size(), data.data(), GL_DYNAMIC_DRAW);
+
+    GLTexture texture;
+    glBindTexture(GL_TEXTURE_BUFFER, texture);
+    glTexBufferRange(GL_TEXTURE_BUFFER, GL_R8I, buffer, 0, 1);
+    EXPECT_GL_ERROR(GL_INVALID_OPERATION);
+
+    GLint value = 0;
+    glGetIntegerv(GL_TEXTURE_BUFFER_OFFSET_ALIGNMENT, &value);
+    EXPECT_GL_ERROR(GL_INVALID_ENUM);
+
+    glTexBuffer(GL_TEXTURE_BUFFER, GL_R8I, buffer);
+    ASSERT_GL_NO_ERROR();
+
+    glGetTexLevelParameteriv(GL_TEXTURE_BUFFER, 0, GL_TEXTURE_BUFFER_DATA_STORE_BINDING, &value);
+    ASSERT_GL_NO_ERROR();
+    EXPECT_EQ(buffer.get(), static_cast<GLuint>(value));
+
+    glGetTexLevelParameteriv(GL_TEXTURE_BUFFER, 0, GL_TEXTURE_BUFFER_OFFSET, &value);
+    EXPECT_GL_ERROR(GL_INVALID_ENUM);
+    glGetTexLevelParameteriv(GL_TEXTURE_BUFFER, 0, GL_TEXTURE_BUFFER_SIZE, &value);
+    EXPECT_GL_ERROR(GL_INVALID_ENUM);
+}
